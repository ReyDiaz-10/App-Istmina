{
  "expo": {
    "name": "IstmiYa",
    "slug": "istmiya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/istmiya-marketplace-icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IstmiYa usa tu ubicación solo para calcular el domicilio y coordinar tu pedido."
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/istmiya-adaptive-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF4E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/istmiya-adaptive-foreground.png",
        "backgroundImage": "./assets/images/istmiya-adaptive-background.png"
      },
      "package": "com.reydiaz10.istmiya"
    },
    "web": {
      "favicon": "./assets/images/istmiya-marketplace-icon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "defaultLanguage": "es-419",
      "eas": {
        "projectId": "62acc73b-4cca-4893-a95e-22b8b64e7d19"
      }
    }
  }
}

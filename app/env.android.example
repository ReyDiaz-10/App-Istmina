# Public Expo app configuration. Never put service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Expo account token used only to download the existing remote Android signing credentials.
# Keep this value private; app/.env.android is ignored by Git and Docker build context.
EXPO_TOKEN=your-expo-access-token
